{
  "extends": ["@arnaud-zg/configs/tsconfig/base.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "checkJs": false,
    "lib": ["ES2022", "dom"],
    "types": ["node"],
    "paths": {
      "migration-preflight": ["../migration-preflight/src"],
      "migration-preflight/sources": ["../migration-preflight/src/sources.ts"],
      "@migration-preflight/postgres": ["./src/index.ts"],
      "@migration-preflight/postgres/drizzle": ["./src/drizzle.ts"]
    }
  },
  "include": ["src/**/*.ts", "examples/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "vitest.config.ts"]
}
