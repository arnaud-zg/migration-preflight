{
  "name": "migration-preflight",
  "version": "0.1.0",
  "description": "Test database migrations before you ship them: plant a row, run the migration, verify it survives.",
  "keywords": [
    "migration",
    "database",
    "sql",
    "testing",
    "preflight",
    "drizzle",
    "prisma",
    "data-safety"
  ],
  "homepage": "https://github.com/arnaud-zg/migration-preflight/tree/main/packages/migration-preflight#readme",
  "bugs": {
    "url": "https://github.com/arnaud-zg/migration-preflight/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnaud-zg/migration-preflight.git",
    "directory": "packages/migration-preflight"
  },
  "license": "MIT",
  "author": "Arnaud Zheng <arnaud.zg@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./sources": "./dist/sources.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache dist node_modules",
    "format": "prettier --write . --ignore-path ../../.prettierignore --cache --cache-location .cache/.prettiercache",
    "lint": "eslint --cache --cache-location .cache/.eslintcache",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "prettier": "@arnaud-zg/configs/prettier",
  "devDependencies": {
    "@arnaud-zg/configs": "catalog:",
    "@types/node": "catalog:node",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
