{
  "name": "@migration-preflight/adapters-sqlite",
  "version": "0.1.0",
  "description": "node:sqlite driver for migration-preflight: test your SQLite migrations with zero runtime dependencies.",
  "keywords": [
    "migration",
    "database",
    "sqlite",
    "node-sqlite",
    "testing",
    "preflight",
    "drizzle",
    "data-safety"
  ],
  "homepage": "https://github.com/arnaud-zg/migration-preflight/tree/main/packages/migration-preflight-adapters-sqlite#readme",
  "bugs": {
    "url": "https://github.com/arnaud-zg/migration-preflight/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnaud-zg/migration-preflight.git",
    "directory": "packages/migration-preflight-adapters-sqlite"
  },
  "license": "MIT",
  "author": "Arnaud Zheng <arnaud.zg@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./drizzle": "./dist/drizzle.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache dist node_modules",
    "format": "prettier --write . --ignore-path ../../.prettierignore --cache --cache-location .cache/.prettiercache",
    "lint": "eslint --cache --cache-location .cache/.eslintcache",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "prettier": "@arnaud-zg/configs/prettier",
  "dependencies": {
    "migration-preflight": "workspace:*"
  },
  "devDependencies": {
    "@arnaud-zg/configs": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:node",
    "better-sqlite3": "12.5.0",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "better-sqlite3": "12.5.0",
    "drizzle-orm": "0.45.2"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
